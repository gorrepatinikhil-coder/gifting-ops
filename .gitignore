# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Next.js build output ─────────────────────────────────────────────────────
.next/
out/
build/

# ─── Environment & secrets ────────────────────────────────────────────────────
# Never commit any .env file that contains real values.
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env*.local

# ─── Prisma ───────────────────────────────────────────────────────────────────
# Migration lock file is safe to commit; generated client is not needed in git.
# prisma/migrations/ is intentionally NOT ignored — migrations belong in source control.

# ─── Vercel ───────────────────────────────────────────────────────────────────
.vercel

# ─── OS / editor artefacts ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
*.pem

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Misc ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/cache
.yarn/unplugged
